# Copy to .env (git-ignored). Phase 0 requires NO credentials.
# --- Required (all have defaults) ---
TYCOON_ENV=development        # development | production
TYCOON_HOST=127.0.0.1         # use 0.0.0.0 only deliberately, for LAN/phone access
TYCOON_PORT=8787
# --- Optional ---
TYCOON_LOG_LEVEL=info         # debug | info | warn | error
TYCOON_DATA_DIR=runtime/data  # DB lives here; must be under runtime/ or outside the repo
TYCOON_LOG_DIR=runtime/logs
# --- AI providers (Phase 6). Nothing here is required: with AI_ACTIVE_PROVIDER unset or "none", AI is disabled. ---
# AI_ACTIVE_PROVIDER=none          # none | claude | openai | ollama | mock (mock is refused in production)
# AI_FALLBACK_PROVIDERS=ollama     # comma separated, tried in order only if listed here
# AI_SELECTION=preferred           # preferred | cost
# AI_CLAUDE_MODEL=claude-opus-5-5
# AI_OPENAI_MODEL=                 # required to use OpenAI (no default)
# AI_OPENAI_ENDPOINT=https://api.openai.com/v1   # https only (http allowed for localhost)
# AI_OLLAMA_MODEL=                 # required to use Ollama (no default)
# AI_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=1
# AI_MAX_COST_PER_REQUEST_USD=     # optional global per-request cost ceiling
# --- Credentials (NEVER commit real values; set them in your private .env or the OS environment) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# FREEBUFF_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
