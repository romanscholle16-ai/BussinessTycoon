# Copy to .env (git-ignored). Phase 0 requires NO credentials.
# --- Required (all have defaults) ---
TYCOON_ENV=development        # development | production
TYCOON_HOST=127.0.0.1         # use 0.0.0.0 only deliberately, for LAN/phone access
TYCOON_PORT=8787
# --- Optional ---
TYCOON_LOG_LEVEL=info         # debug | info | warn | error
TYCOON_DATA_DIR=runtime/data  # DB lives here; must be under runtime/ or outside the repo
TYCOON_LOG_DIR=runtime/logs
# --- Credentials (unused until later phases; NEVER commit real values) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# FREEBUFF_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
